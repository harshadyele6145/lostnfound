PORT=5000
DATABASE_URL=postgresql://postgres:your-password@localhost:5432/campusfind?schema=public
JWT_SECRET=replace-with-a-long-random-secret
CLIENT_URL=http://localhost:5173
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Email settings
EMAIL_ENABLED=false
EMAIL_FROM=CampusFind <no-reply@campusfind.local>
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Optional: lock registrations to one exact campus domain, e.g. mycollege.edu.
# If left blank, any .edu address is accepted.
CAMPUS_EMAIL_DOMAIN=
AI_PROVIDER=fallback
